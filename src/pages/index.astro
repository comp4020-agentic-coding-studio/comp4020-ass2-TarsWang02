---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Twelve weeks, one jump. You'll tune a single 2D jump — how high it goes,
    how it responds to your input, how forgiving it is, and eventually how it
    looks — and measure the result every time, instead of guessing whether a
    change made it feel better. No code is required to complete the core
    work: every experiment runs in the browser through visual controls, and a
    guided starter-code path is there if you want to go further. You'll
    finish having designed and defended one jump you can explain in numbers,
    not just adjectives.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone curious about why one jump in a game feels different from another,
    with no assumed background in game development, physics or programming.
    If you've ever said a jump felt "floaty" or "snappy" and wondered what
    that actually meant, this course turns that question into something you
    can test.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Weeks" href="/weeks/">
      <p>The twelve-week schedule, grouped by phase, with lectures and {sessionLabels.plural.toLowerCase()}.</p>
    </Card>
    <Card title="Jump Lab" href="/jump-lab/">
      <p>Try a jump, compare presets, and run the same experiments used across the course.</p>
    </Card>
    <Card title="Assessments" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
